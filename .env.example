# ============================================================
# OTOCLIC CRM — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Otoclic CRM

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=crm@otoclic.ma
RESEND_FROM_NAME=Otoclic CRM

# Webhooks (sécurité)
WEBHOOK_SECRET=changez-moi-en-production-32-chars-min

# WhatsApp (Phase 3)
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v20.0

# Téléphonie (Phase 3) — 'tel' (natif) par défaut, 'twilio' pour le click-to-call VoIP
# TELEPHONY_PROVIDER=tel
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_AGENT_NUMBER=

# Google Calendar (Phase 3)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_CALENDAR_ACCESS_TOKEN=
# GOOGLE_CALENDAR_ID=primary

# Node
NODE_ENV=development
